# Copy to .env to run the app or tests on the host against `docker compose up postgres sqs sqs-init`.
# Bun loads .env automatically. Inside Docker Compose these values are set by docker-compose.yml.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Comma-separated subset of: api,consumer,outbox,pending
APP_ROLES=api,consumer,outbox,pending

DATABASE_HOST=localhost
DATABASE_PORT=55432
DATABASE_NAME=wagering
DATABASE_USER=wagering
DATABASE_PASSWORD=wagering
DATABASE_POOL_MAX=20

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wagering-events.fifo
SQS_MAX_RECEIVE_COUNT=5
