# Copy to .env to run the app or tests on the host against `docker compose up postgres sqs sqs-init`.
# Bun loads .env automatically. Inside Docker Compose these values are set by docker-compose.yml.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Comma-separated subset of: api,consumer,outbox,pending
APP_ROLES=api,consumer,outbox,pending

DATABASE_HOST=localhost
DATABASE_PORT=55432
DATABASE_NAME=wagering
DATABASE_USER=wagering
DATABASE_PASSWORD=wagering
DATABASE_POOL_MAX=20
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_CONNECT_TIMEOUT_MS=5000
# Must be greater than DATABASE_STATEMENT_TIMEOUT_MS: only fires when the server stops answering.
DATABASE_QUERY_TIMEOUT_MS=20000

PENDING_REFERENCE_BASE_DELAY_MS=1000
PENDING_REFERENCE_MAX_DELAY_MS=60000
PENDING_REFERENCE_MAX_ATTEMPTS=10
PENDING_REFERENCE_POLL_INTERVAL_MS=500
PENDING_REFERENCE_BATCH_SIZE=20
# Non-temporary failures (a bug, invalid data) before a pending transaction becomes FAILED.
PENDING_REFERENCE_MAX_PROCESSING_FAILURES=3

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wagering-events.fifo
SQS_MAX_RECEIVE_COUNT=5
SQS_CONNECT_TIMEOUT_MS=3000
# Must be greater than SQS_CONSUMER_WAIT_TIME_SECONDS (long poll), in milliseconds.
SQS_REQUEST_TIMEOUT_MS=25000
